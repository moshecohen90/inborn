{
  "name": "@inborn/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "android": "APP_VARIANT=development expo start --android",
    "ios": "APP_VARIANT=development expo start --ios",
    "web": "pnpm run wasm && APP_VARIANT=development expo start --web",
    "export:web": "pnpm run wasm && expo export -p web",
    "wasm": "mkdir -p public/wllama/compat && cp node_modules/@wllama/wllama/esm/wasm/wllama.wasm public/wllama/ && cp node_modules/@wllama/wllama-compat/wasm/wllama.js node_modules/@wllama/wllama-compat/wasm/wllama.wasm public/wllama/compat/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@formatjs/intl-getcanonicallocales": "^3.2.11",
    "@formatjs/intl-locale": "^5.3.10",
    "@formatjs/intl-pluralrules": "^6.3.13",
    "@inborn/core": "workspace:*",
    "@inborn/i18n": "workspace:*",
    "@inborn/ui": "workspace:*",
    "@noble/hashes": "1.8.0",
    "@wllama/wllama": "3.6.1",
    "@wllama/wllama-compat": "3.6.1",
    "expo": "~57.0.19",
    "expo-clipboard": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "i18next": "26.4.1",
    "llama.rn": "0.12.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.13",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
