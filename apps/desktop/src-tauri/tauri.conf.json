{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Inborn",
  "identifier": "com.inbornapp.desktop",
  "version": "0.0.1",
  "build": {
    "frontendDist": "../../mobile/dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "cd ../mobile && APP_VARIANT=development npx expo start --web --port 8081",
    "beforeBuildCommand": "cd ../mobile && npx expo export -p web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Inborn",
        "width": 1120,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "certificateThumbprint": null
    }
  }
}
