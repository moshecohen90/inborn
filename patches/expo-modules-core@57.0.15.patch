+/// Xcode 26.2's Swift rejects a `nonisolated(unsafe) weak let` capture crossing into the `@JavaScriptActor` region;
+/// the box carries the same promise (only actor-isolated or Sendable state is reached through the emitter).
+private final class WeakEmitterRef: @unchecked Sendable {
+  weak var value: (any EventEmitter)?
+  init(_ value: any EventEmitter) { self.value = value }
