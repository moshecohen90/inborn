{
  "runId": "c2-hebrew-name",
  "_": "A copy of the 9-page fixture named קובץ.pdf at the Documents root, attached in the chat: the attached-file row, 'Summarize it' on Instant and its chips, the attach sheet's row, the Documents screen's row.",
  "steps": [
    {
      "op": "deeplink",
      "url": "/"
    },
    {
      "op": "waitFor",
      "testID": "composer-input",
      "timeoutMs": 60000
    },
    {
      "op": "devPrompt",
      "lines": [
        "attach: קובץ.pdf"
      ]
    },
    {
      "op": "sleep",
      "ms": 45000
    },
    {
      "op": "screenshot",
      "name": "01-attached-row"
    },
    {
      "op": "dump",
      "name": "01-attached-row"
    },
    {
      "op": "type",
      "testID": "composer-input",
      "text": "Summarize it"
    },
    {
      "op": "send"
    },
    {
      "op": "waitFor",
      "testID": "reading-pages",
      "timeoutMs": 180000
    },
    {
      "op": "waitFor",
      "testID": "reading-pages",
      "gone": true,
      "timeoutMs": 900000
    },
    {
      "op": "waitFor",
      "testID": "stop",
      "gone": true,
      "timeoutMs": 600000
    },
    {
      "op": "sleep",
      "ms": 3000
    },
    {
      "op": "screenshot",
      "name": "02-summary-chips"
    },
    {
      "op": "dump",
      "name": "02-summary-chips"
    },
    {
      "op": "press",
      "testID": "attach"
    },
    {
      "op": "waitFor",
      "testID": "attach-sheet",
      "timeoutMs": 10000
    },
    {
      "op": "sleep",
      "ms": 1500
    },
    {
      "op": "screenshot",
      "name": "03-attach-sheet"
    },
    {
      "op": "press",
      "testID": "attach-sheet-close"
    },
    {
      "op": "sleep",
      "ms": 1000
    },
    {
      "op": "deeplink",
      "url": "/documents"
    },
    {
      "op": "sleep",
      "ms": 3000
    },
    {
      "op": "screenshot",
      "name": "04-documents"
    },
    {
      "op": "dump",
      "name": "04-documents"
    }
  ]
}