{
  "runId": "l3-lexical-door-fast",
  "_": "fast, the constitution fixture and the index model: summary, then 'give me a pancake recipe' (no chip, the none-matched line), then 'Who can veto a bill?' (chips). The shell writes `use fast` to Documents/dev-vault.txt and copies the fixture into Documents first.",
  "steps": [
    {
      "op": "deeplink",
      "url": "/vault"
    },
    {
      "op": "sleep",
      "ms": 10000
    },
    {
      "op": "deeplink",
      "url": "/"
    },
    {
      "op": "waitFor",
      "testID": "open-chats",
      "timeoutMs": 30000
    },
    {
      "op": "press",
      "testID": "open-chats"
    },
    {
      "op": "waitFor",
      "testID": "new-chat",
      "timeoutMs": 15000
    },
    {
      "op": "press",
      "testID": "new-chat"
    },
    {
      "op": "waitFor",
      "testID": "start-chat",
      "timeoutMs": 15000
    },
    {
      "op": "press",
      "testID": "start-chat"
    },
    {
      "op": "waitFor",
      "testID": "composer-input",
      "timeoutMs": 60000
    },
    {
      "op": "sleep",
      "ms": 5000
    },
    {
      "op": "devPrompt",
      "lines": [
        "attach: constitution-9pages.pdf"
      ]
    },
    {
      "op": "sleep",
      "ms": 60000
    },
    {
      "op": "screenshot",
      "name": "f01-attached"
    },
    {
      "op": "type",
      "testID": "composer-input",
      "text": "Summarize it"
    },
    {
      "op": "send"
    },
    {
      "op": "sleep",
      "ms": 5000
    },
    {
      "op": "waitFor",
      "testID": "stop",
      "gone": true,
      "timeoutMs": 900000
    },
    {
      "op": "sleep",
      "ms": 3000
    },
    {
      "op": "screenshot",
      "name": "f02-summary"
    },
    {
      "op": "dump",
      "name": "f02-summary"
    },
    {
      "op": "type",
      "testID": "composer-input",
      "text": "give me a pancake recipe"
    },
    {
      "op": "send"
    },
    {
      "op": "sleep",
      "ms": 5000
    },
    {
      "op": "waitFor",
      "testID": "stop",
      "gone": true,
      "timeoutMs": 900000
    },
    {
      "op": "sleep",
      "ms": 3000
    },
    {
      "op": "screenshot",
      "name": "f03-pancakes"
    },
    {
      "op": "dump",
      "name": "f03-pancakes"
    },
    {
      "op": "type",
      "testID": "composer-input",
      "text": "Who can veto a bill?"
    },
    {
      "op": "send"
    },
    {
      "op": "sleep",
      "ms": 5000
    },
    {
      "op": "waitFor",
      "testID": "stop",
      "gone": true,
      "timeoutMs": 900000
    },
    {
      "op": "sleep",
      "ms": 3000
    },
    {
      "op": "screenshot",
      "name": "f04-veto"
    },
    {
      "op": "dump",
      "name": "f04-veto"
    }
  ]
}