{
  "runId": "s3-text-pdf-hold",
  "_": "A new chat, turbine-report-3pages.pdf attached, a question: the index-model card still holds it.",
  "steps": [
    {
      "op": "deeplink",
      "url": "/chats"
    },
    {
      "op": "waitFor",
      "testID": "new-chat",
      "timeoutMs": 20000
    },
    {
      "op": "press",
      "testID": "new-chat"
    },
    {
      "op": "waitFor",
      "testID": "start-chat",
      "timeoutMs": 10000
    },
    {
      "op": "press",
      "testID": "start-chat"
    },
    {
      "op": "waitFor",
      "testID": "composer-input",
      "timeoutMs": 60000
    },
    {
      "op": "sleep",
      "ms": 5000
    },
    {
      "op": "devPrompt",
      "lines": [
        "attach: turbine-report-3pages.pdf"
      ]
    },
    {
      "op": "sleep",
      "ms": 20000
    },
    {
      "op": "type",
      "testID": "composer-input",
      "text": "What does the report say about the turbine?"
    },
    {
      "op": "send"
    },
    {
      "op": "waitFor",
      "testID": "docs-hold",
      "timeoutMs": 30000
    },
    {
      "op": "sleep",
      "ms": 1500
    },
    {
      "op": "screenshot",
      "name": "05-docs-hold"
    },
    {
      "op": "dump",
      "name": "05-docs-hold"
    }
  ]
}