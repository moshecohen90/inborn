{
  "runId": "s1b-download-waits",
  "_": "Fast picked and Download pressed; the models host is a closed localhost port, so the download waits or fails: the source line must still name its host. Then \"Start now with Instant\" (testID start-chatting).",
  "steps": [
    {
      "op": "press",
      "testID": "model-option-fast"
    },
    {
      "op": "sleep",
      "ms": 800
    },
    {
      "op": "press",
      "testID": "download-model"
    },
    {
      "op": "sleep",
      "ms": 6000
    },
    {
      "op": "screenshot",
      "name": "01b-download-waits"
    },
    {
      "op": "dump",
      "name": "01b-download-waits"
    },
    {
      "op": "sleep",
      "ms": 10000
    },
    {
      "op": "screenshot",
      "name": "01c-download-later"
    },
    {
      "op": "dump",
      "name": "01c-download-later"
    },
    {
      "op": "press",
      "testID": "start-chatting"
    },
    {
      "op": "waitFor",
      "testID": "sealed-start",
      "timeoutMs": 30000
    },
    {
      "op": "sleep",
      "ms": 8000
    },
    {
      "op": "press",
      "testID": "sealed-start"
    },
    {
      "op": "waitFor",
      "testID": "lock-start",
      "timeoutMs": 20000
    },
    {
      "op": "press",
      "testID": "lock-start"
    },
    {
      "op": "waitFor",
      "testID": "composer-input",
      "timeoutMs": 60000
    },
    {
      "op": "sleep",
      "ms": 20000
    },
    {
      "op": "screenshot",
      "name": "01d-chat"
    },
    {
      "op": "dump",
      "name": "01d-chat"
    }
  ]
}