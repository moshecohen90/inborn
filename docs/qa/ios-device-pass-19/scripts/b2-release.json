"timeoutMs": 10000
},
{
"op": "press",
"testID": "start-chat"
},
{
"op": "waitFor",
"testID": "composer-input",
"timeoutMs": 30000
},
{
"op": "sleep",
"ms": 1500
},
{
"op": "devPrompt",
