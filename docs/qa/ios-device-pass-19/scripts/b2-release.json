"timeoutMs": 300
},
{
"op": "waitFor",
"testID": "user-images",
"timeoutMs": 3000000
},
{
"op": "sleep",
"ms": 1500
},
{
"op": "screenshot",
"name": "B12-held-turn-released"
},
{
"op": "waitFor",
"testID": "vision-hold",
"gone": true,
"timeoutMs": 5000
},
{
"op": "waitFor",
"testID": "assistant-text",
"timeoutMs": 300000
},
{
"op": "sleep",
"ms": 45000
},
{
"op": "screenshot",
"name": "B13-answer"
},
{
"op": "value",
"testID": "assistant-text"
},
{
"op": "dump",
