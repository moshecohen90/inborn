{
  "runId": "s8-docs-held-download",
  "_": "Instant with no index model on the phone: the text PDF attached, a question, the index card; Download; the message waits while the file is read with the new index model ('Reading your document before answering\u2026'), then the first answer comes from the file with its source.",
  "steps": [
    {
      "op": "deeplink",
      "url": "/"
    },
    {
      "op": "waitFor",
      "testID": "composer-input",
      "timeoutMs": 60000
    },
    {
      "op": "sleep",
      "ms": 5000
    },
    {
      "op": "devPrompt",
      "lines": [
        "attach: turbine-report-3pages.pdf"
      ]
    },
    {
      "op": "sleep",
      "ms": 10000
    },
    {
      "op": "type",
      "testID": "composer-input",
      "text": "What does the report say about the turbine?"
    },
    {
      "op": "send"
    },
    {
      "op": "waitFor",
      "testID": "docs-hold",
      "timeoutMs": 30000
    },
    {
      "op": "sleep",
      "ms": 1500
    },
    {
      "op": "screenshot",
      "name": "2a-12-docs-hold"
    },
    {
      "op": "dump",
      "name": "2a-12-docs-hold"
    },
    {
      "op": "press",
      "testID": "docs-hold-download"
    },
    {
      "op": "sleep",
      "ms": 2000
    },
    {
      "op": "screenshot",
      "name": "2a-13-downloading"
    },
    {
      "op": "waitFor",
      "testID": "docs-hold",
      "gone": true,
      "timeoutMs": 300000
    },
    {
      "op": "screenshot",
      "name": "2a-14-reading-your-document"
    },
    {
      "op": "dump",
      "name": "2a-14-reading-your-document"
    },
    {
      "op": "waitFor",
      "testID": "stop",
      "timeoutMs": 180000
    },
    {
      "op": "screenshot",
      "name": "2a-15-answer-starts"
    },
    {
      "op": "waitFor",
      "testID": "stop",
      "gone": true,
      "timeoutMs": 240000
    },
    {
      "op": "sleep",
      "ms": 2500
    },
    {
      "op": "screenshot",
      "name": "2a-16-grounded-answer"
    },
    {
      "op": "dump",
      "name": "2a-16-grounded-answer"
    }
  ]
}