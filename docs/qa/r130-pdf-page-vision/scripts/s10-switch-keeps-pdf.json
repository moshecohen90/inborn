{
  "runId": "s10-switch-keeps-pdf",
  "_": "Exit (b): Fast without its pack, a new chat, the visual PDF, 'What do you see?', the pack offer; 'Switch to INSTANT': the new chat on Instant gets the same PDF and the same message, which goes out by itself with the page picture.",
  "steps": [
    {
      "op": "deeplink",
      "url": "/chats"
    },
    {
      "op": "waitFor",
      "testID": "new-chat",
      "timeoutMs": 20000
    },
    {
      "op": "press",
      "testID": "new-chat"
    },
    {
      "op": "waitFor",
      "testID": "start-chat",
      "timeoutMs": 10000
    },
    {
      "op": "press",
      "testID": "start-chat"
    },
    {
      "op": "waitFor",
      "testID": "composer-input",
      "timeoutMs": 60000
    },
    {
      "op": "sleep",
      "ms": 5000
    },
    {
      "op": "devPrompt",
      "lines": [
        "attach: visual-page.pdf"
      ]
    },
    {
      "op": "sleep",
      "ms": 20000
    },
    {
      "op": "type",
      "testID": "composer-input",
      "text": "What do you see?"
    },
    {
      "op": "send"
    },
    {
      "op": "waitFor",
      "testID": "vision-hold",
      "timeoutMs": 30000
    },
    {
      "op": "sleep",
      "ms": 1500
    },
    {
      "op": "screenshot",
      "name": "1b-21-pack-offer"
    },
    {
      "op": "dump",
      "name": "1b-21-pack-offer"
    },
    {
      "op": "press",
      "testID": "vision-hold-switch"
    },
    {
      "op": "waitFor",
      "testID": "stop",
      "timeoutMs": 180000
    },
    {
      "op": "screenshot",
      "name": "1b-22-sent"
    },
    {
      "op": "dump",
      "name": "1b-22-sent"
    },
    {
      "op": "waitFor",
      "testID": "stop",
      "gone": true,
      "timeoutMs": 300000
    },
    {
      "op": "sleep",
      "ms": 2500
    },
    {
      "op": "screenshot",
      "name": "1b-22-answer"
    },
    {
      "op": "dump",
      "name": "1b-22-answer"
    }
  ]
}