{
 "_": "J4 PRIVATE: a new chat on Fast, 'קובץ.pdf' (the founder's 9-page file under a neutral name), 'Summarize it': no index card, 'Reading pages…', the summary with 'Summary of all 9 pages.'; then 'What is this file about?' in the same chat. Output stays in private/.",
 "steps": [
  {
   "op": "deeplink",
   "url": "/chats"
  },
  {
   "op": "waitFor",
   "testID": "new-chat",
   "timeoutMs": 15000
  },
  {
   "op": "press",
   "testID": "new-chat"
  },
  {
   "op": "waitFor",
   "testID": "start-chat",
   "timeoutMs": 10000
  },
  {
   "op": "press",
   "testID": "start-chat"
  },
  {
   "op": "waitFor",
   "testID": "composer-input",
   "timeoutMs": 30000
  },
  {
   "op": "waitFor",
   "text": "Loading",
   "gone": true,
   "timeoutMs": 180000
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "value",
   "testID": "model-chip"
  },
  {
   "op": "press",
   "testID": "model-chip"
  },
  {
   "op": "waitFor",
   "testID": "model-sheet-use-fast",
   "timeoutMs": 10000
  },
  {
   "op": "press",
   "testID": "model-sheet-use-fast"
  },
  {
   "op": "sleep",
   "ms": 3000
  },
  {
   "op": "waitFor",
   "text": "Loading",
   "gone": true,
   "timeoutMs": 240000
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "value",
   "testID": "model-chip"
  },
  {
   "op": "assertText",
   "text": "FAST",
   "testID": "model-chip"
  },
  {
   "op": "devPrompt",
   "lines": [
    "attach: קובץ.pdf"
   ]
  },
  {
   "op": "waitFor",
   "testID": "attached-docs",
   "timeoutMs": 60000
  },
  {
   "op": "sleep",
   "ms": 20000
  },
  {
   "op": "value",
   "testID": "attached-docs"
  },
  {
   "op": "screenshot",
   "name": "P4-01-attached"
  },
  {
   "op": "type",
   "testID": "composer-input",
   "text": "Summarize it"
  },
  {
   "op": "send"
  },
  {
   "op": "waitFor",
   "testID": "reading-pages",
   "timeoutMs": 120000
  },
  {
   "op": "value",
   "testID": "reading-pages"
  },
  {
   "op": "waitFor",
   "testID": "docs-hold",
   "gone": true,
   "timeoutMs": 1000
  },
  {
   "op": "screenshot",
   "name": "P4-02-reading"
  },
  {
   "op": "waitFor",
   "testID": "reading-pages",
   "gone": true,
   "timeoutMs": 900000
  },
  {
   "op": "waitFor",
   "testID": "assistant-text",
   "timeoutMs": 240000
  },
  {
   "op": "waitFor",
   "testID": "stop",
   "gone": true,
   "timeoutMs": 600000
  },
  {
   "op": "sleep",
   "ms": 2500
  },
  {
   "op": "value",
   "testID": "assistant-text"
  },
  {
   "op": "value",
   "testID": "citations"
  },
  {
   "op": "assertText",
   "text": "Summary of all 9 pages.",
   "testID": "assistant-text"
  },
  {
   "op": "screenshot",
   "name": "P4-02-summary"
  },
  {
   "op": "dump",
   "name": "P4-02-summary"
  },
  {
   "op": "assertText",
   "text": "The request specifies",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "I will focus",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "as an AI",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "NOT_FOUND",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "<<<",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "The user is asking",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "Nothing in your documents matched this question",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "press",
   "testID": "ledger-toggle"
  },
  {
   "op": "sleep",
   "ms": 1200
  },
  {
   "op": "value",
   "testID": "ledger"
  },
  {
   "op": "screenshot",
   "name": "P4-02-ledger"
  },
  {
   "op": "type",
   "testID": "composer-input",
   "text": "What is this file about?"
  },
  {
   "op": "send"
  },
  {
   "op": "sleep",
   "ms": 6000
  },
  {
   "op": "screenshot",
   "name": "P4-03-after-send"
  },
  {
   "op": "dump",
   "name": "P4-03-after-send"
  },
  {
   "op": "value",
   "testID": "docs-hold"
  },
  {
   "op": "press",
   "testID": "docs-hold-download"
  },
  {
   "op": "idleTimer"
  },
  {
   "op": "waitFor",
   "testID": "docs-hold",
   "gone": true,
   "timeoutMs": 1800000
  },
  {
   "op": "sleep",
   "ms": 6000
  },
  {
   "op": "waitFor",
   "testID": "stop",
   "gone": true,
   "timeoutMs": 600000
  },
  {
   "op": "sleep",
   "ms": 2500
  },
  {
   "op": "value",
   "testID": "assistant-text"
  },
  {
   "op": "value",
   "testID": "citations"
  },
  {
   "op": "screenshot",
   "name": "P4-03-answer"
  },
  {
   "op": "dump",
   "name": "P4-03-answer"
  },
  {
   "op": "assertText",
   "text": "The request specifies",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "I will focus",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "as an AI",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "NOT_FOUND",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "<<<",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "The user is asking",
   "testID": "assistant-text",
   "absent": true
  }
 ]
}
