{
  "runId": "s1-onboard-fast",
  "_": "Fresh install: Download Fast from the local model server, then seal and lock steps to the chat on Fast.",
  "steps": [
    {
      "op": "waitFor",
      "testID": "onboarding-continue",
      "timeoutMs": 90000
    },
    {
      "op": "press",
      "testID": "onboarding-continue"
    },
    {
      "op": "waitFor",
      "testID": "onboarding-model",
      "timeoutMs": 30000
    },
    {
      "op": "sleep",
      "ms": 1500
    },
    {
      "op": "press",
      "testID": "download-model"
    },
    {
      "op": "waitFor",
      "testID": "start-chatting",
      "timeoutMs": 600000
    },
    {
      "op": "press",
      "testID": "start-chatting"
    },
    {
      "op": "waitFor",
      "testID": "sealed-start",
      "timeoutMs": 30000
    },
    {
      "op": "sleep",
      "ms": 8000
    },
    {
      "op": "press",
      "testID": "sealed-start"
    },
    {
      "op": "waitFor",
      "testID": "lock-start",
      "timeoutMs": 20000
    },
    {
      "op": "press",
      "testID": "lock-start"
    },
    {
      "op": "waitFor",
      "testID": "composer-input",
      "timeoutMs": 120000
    },
    {
      "op": "sleep",
      "ms": 10000
    },
    {
      "op": "screenshot",
      "name": "01-chat-fast"
    }
  ]
}