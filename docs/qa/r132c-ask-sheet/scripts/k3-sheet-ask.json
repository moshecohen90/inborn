{
  "runId": "k3-sheet-ask",
  "_": "Documents \u2192 select the 9-page fixture \u2192 Ask: 'Summarize it' (reading line, summary with the scope and Instant lines, stats 'read \u2026 9 of 9 pages'), the same ask stopped while reading (sheet clean), then a normal question and 'What is this file about?' still on retrieval ('\u2026 passages'). DOCID is replaced by the shell with the id from k2's dump.",
  "steps": [
    {
      "op": "waitFor",
      "testID": "doc-select-DOCID",
      "timeoutMs": 30000
    },
    {
      "op": "sleep",
      "ms": 60000
    },
    {
      "op": "press",
      "testID": "doc-select-DOCID"
    },
    {
      "op": "press",
      "testID": "documents-ask-selected"
    },
    {
      "op": "waitFor",
      "testID": "ask-sheet",
      "timeoutMs": 20000
    },
    {
      "op": "screenshot",
      "name": "03a-sheet"
    },
    {
      "op": "type",
      "testID": "ask-input",
      "text": "Summarize it"
    },
    {
      "op": "press",
      "testID": "ask-send"
    },
    {
      "op": "waitFor",
      "testID": "ask-reading-pages",
      "timeoutMs": 120000
    },
    {
      "op": "screenshot",
      "name": "03b-reading"
    },
    {
      "op": "dump",
      "name": "03b-reading"
    },
    {
      "op": "waitFor",
      "testID": "ask-stop",
      "gone": true,
      "timeoutMs": 900000
    },
    {
      "op": "sleep",
      "ms": 2000
    },
    {
      "op": "screenshot",
      "name": "03c-summary"
    },
    {
      "op": "dump",
      "name": "03c-summary"
    },
    {
      "op": "assertText",
      "testID": "ask-answer",
      "text": "Summary of all 9 pages."
    },
    {
      "op": "assertText",
      "testID": "ask-answer",
      "text": "can miss or mix up details of a long file"
    },
    {
      "op": "assertText",
      "testID": "ask-stats",
      "text": "9 of 9 pages"
    },
    {
      "op": "waitFor",
      "testID": "ask-none-matched",
      "gone": true,
      "timeoutMs": 1000
    },
    {
      "op": "waitFor",
      "testID": "ask-not-found",
      "gone": true,
      "timeoutMs": 1000
    },
    {
      "op": "type",
      "testID": "ask-input",
      "text": "Summarize it"
    },
    {
      "op": "press",
      "testID": "ask-send"
    },
    {
      "op": "waitFor",
      "testID": "ask-reading-pages",
      "timeoutMs": 120000
    },
    {
      "op": "press",
      "testID": "ask-stop"
    },
    {
      "op": "waitFor",
      "testID": "ask-send",
      "timeoutMs": 60000
    },
    {
      "op": "sleep",
      "ms": 3000
    },
    {
      "op": "waitFor",
      "testID": "ask-answer",
      "gone": true,
      "timeoutMs": 1000
    },
    {
      "op": "waitFor",
      "testID": "ask-stats",
      "gone": true,
      "timeoutMs": 1000
    },
    {
      "op": "screenshot",
      "name": "04-stopped"
    },
    {
      "op": "dump",
      "name": "04-stopped"
    },
    {
      "op": "type",
      "testID": "ask-input",
      "text": "Who can veto a bill?"
    },
    {
      "op": "press",
      "testID": "ask-send"
    },
    {
      "op": "waitFor",
      "testID": "ask-stop",
      "gone": true,
      "timeoutMs": 600000
    },
    {
      "op": "sleep",
      "ms": 2000
    },
    {
      "op": "screenshot",
      "name": "05-question"
    },
    {
      "op": "dump",
      "name": "05-question"
    },
    {
      "op": "assertText",
      "testID": "ask-stats",
      "text": "passages"
    },
    {
      "op": "type",
      "testID": "ask-input",
      "text": "What is this file about?"
    },
    {
      "op": "press",
      "testID": "ask-send"
    },
    {
      "op": "waitFor",
      "testID": "ask-stop",
      "gone": true,
      "timeoutMs": 600000
    },
    {
      "op": "sleep",
      "ms": 2000
    },
    {
      "op": "screenshot",
      "name": "06-about"
    },
    {
      "op": "dump",
      "name": "06-about"
    },
    {
      "op": "assertText",
      "testID": "ask-stats",
      "text": "passages"
    },
    {
      "op": "assertText",
      "testID": "ask-answer",
      "text": "Summary of all",
      "absent": true
    }
  ]
}
