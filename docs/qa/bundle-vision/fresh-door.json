{
  "runId": "fresh-door",
  "_": "F340/F342: fresh install, cold launch, a photo of a door as the first message. Run: node scripts/ios-qa.mjs docs/qa/bundle-vision/fresh-door.json --out docs/qa/bundle-vision/<dir> --simulator --device <sim-udid> --bundle com.inbornapp.mobile.qa --launch --timeout 1200000 (door.jpg copied into the app's Documents first).",
  "steps": [
    { "op": "waitFor", "testID": "onboarding-continue", "timeoutMs": 90000 },
    { "op": "sleep", "ms": 1200 },
    { "op": "screenshot", "name": "00-welcome" },
    { "op": "press", "testID": "onboarding-continue" },
    { "op": "waitFor", "testID": "start-chatting", "timeoutMs": 30000 },
    { "op": "sleep", "ms": 1500 },
    { "op": "screenshot", "name": "01-model-step" },
    { "op": "dump", "name": "model-step" },
    { "op": "press", "testID": "start-chatting" },
    { "op": "waitFor", "testID": "sealed-start", "timeoutMs": 30000 },
    { "op": "sleep", "ms": 8000 },
    { "op": "press", "testID": "sealed-start" },
    { "op": "waitFor", "testID": "lock-start", "timeoutMs": 20000 },
    { "op": "press", "testID": "lock-start" },
    { "op": "waitFor", "testID": "composer-input", "timeoutMs": 60000 },
    { "op": "sleep", "ms": 2000 },
    { "op": "screenshot", "name": "02-empty-chat" },
    { "op": "devPrompt", "lines": ["image: door.jpg"] },
    { "op": "waitFor", "testID": "pending-images", "timeoutMs": 60000 },
    { "op": "sleep", "ms": 1000 },
    { "op": "screenshot", "name": "03-door-attached" },
    { "op": "type", "testID": "composer-input", "text": "What is in this photo?" },
    { "op": "send" },
    { "op": "waitFor", "testID": "assistant-text", "timeoutMs": 240000 },
    { "op": "sleep", "ms": 60000 },
    { "op": "screenshot", "name": "04-door-answer" },
    { "op": "value", "testID": "assistant-text" },
    { "op": "dump", "name": "chat-after" },
    { "op": "deeplink", "url": "/vault" },
    { "op": "sleep", "ms": 3000 },
    { "op": "screenshot", "name": "05-vault" },
    { "op": "dump", "name": "vault" },
    { "op": "cleanup" }
  ]
}
