   "lines": [
    "attach: sign-scan.pdf"
   ]
  },
  {
   "op": "waitFor",
   "testID": "attached-docs",
   "timeoutMs": 60000
  },
  {
   "op": "sleep",
   "ms": 15000
  },
  {
   "op": "value",
   "testID": "attached-docs"
  },
  {
   "op": "screenshot",
   "name": "03-composer-chip"
  },
  {
   "op": "dump",
   "name": "03-composer-chip"
  },
  {
   "op": "type",
   "testID": "composer-input",
   "text": "What do you see?"
  },
  {
   "op": "send"
  },
  {
   "op": "sleep",
   "ms": 2500
  },
  {
   "op": "screenshot",
   "name": "04-sent-bubble"
  },
  {
   "op": "dump",
   "name": "04-sent-bubble"
  },
  {
   "op": "waitFor",
   "testID": "stop",
   "gone": true,
   "timeoutMs": 240000
  },
  {
   "op": "sleep",
   "ms": 2500
  },
  {
   "op": "screenshot",
   "name": "05-answer"
  },
  {
   "op": "dump",
   "name": "05-answer"
  }
 ]
