{
 "runId": "s5-fast-scan",
 "_": "Fast without its photo pack, a new chat, sign-scan.pdf, 'What do you see?': the pack card, no answer.",
 "steps": [
  {
   "op": "deeplink",
   "url": "/chats"
  },
  {
   "op": "waitFor",
   "testID": "new-chat",
   "timeoutMs": 20000
  },
  {
   "op": "press",
   "testID": "new-chat"
  },
  {
   "op": "waitFor",
   "testID": "start-chat",
   "timeoutMs": 10000
  },
  {
   "op": "press",
   "testID": "start-chat"
  },
  {
   "op": "waitFor",
   "testID": "composer-input",
   "timeoutMs": 60000
  },
  {
   "op": "waitFor",
   "text": "Loading",
   "gone": true,
   "timeoutMs": 180000
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "value",
   "testID": "model-chip"
  },
  {
   "op": "assertText",
   "text": "FAST",
   "testID": "model-chip"
  },
  {
   "op": "devPrompt",
   "lines": [
    "attach: sign-scan.pdf"
   ]
  },
  {
   "op": "waitFor",
   "testID": "attached-docs",
   "timeoutMs": 60000
  },
  {
   "op": "sleep",
   "ms": 8000
  },
  {
   "op": "type",
   "testID": "composer-input",
   "text": "What do you see?"
  },
  {
   "op": "send"
  },
  {
   "op": "waitFor",
   "testID": "vision-hold",
   "timeoutMs": 30000
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "value",
   "testID": "vision-hold"
  },
  {
   "op": "assertText",
   "text": "668 MB",
   "testID": "vision-hold"
  },
  {
   "op": "screenshot",
   "name": "08-fast-pack-card"
  },
  {
   "op": "dump",
   "name": "08-fast-pack-card"
  }
 ]
}