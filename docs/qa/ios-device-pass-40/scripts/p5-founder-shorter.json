   "timeoutMs": 1000
  },
  {
   "op": "waitFor",
   "testID": "none-matched",
   "gone": true,
   "timeoutMs": 1000
  },
  {
   "op": "assertText",
   "text": "468 MB",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "Nothing in your documents matched this question",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "welcome",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "Welcome",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "You're",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "screenshot",
