diff --git a/apps/mobile/src/qa/runtime.ts b/apps/mobile/src/qa/runtime.ts
index dabcbe3e..1f113cf4 100644
--- a/apps/mobile/src/qa/runtime.ts
+++ b/apps/mobile/src/qa/runtime.ts
@@ -169,6 +169,17 @@ export function createSurface(getHandle: () => unknown, runId: string): Surface
     cleanup,
     sleep,
     now: () => Date.now(),
+    async embedProbe(texts) {
+      const { resolveEmbedder } = await import("../documents/embedder");
+      const r = resolveEmbedder();
+      if (!r) throw new Error("embedProbe: no index model installed");
+      const began = Date.now();
+      const vectors: number[][] = [];
+      /* One text per call, as EmbedLanes hands them to the engine. */
+      for (const t of texts) vectors.push(Array.from((await r.embedder.embed([t]))[0]!, (x) => Math.round(x * 1e6) / 1e6));
+      await r.embedder.unload();
+      return { vectors, model: r.path.split("/").pop() ?? r.path, ms: Date.now() - began };
+    },
   };
 }
 
