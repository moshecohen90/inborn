diff --git a/apps/mobile/src/qa/runtime.ts b/apps/mobile/src/qa/runtime.ts
index dabcbe3e..72795cc5 100644
--- a/apps/mobile/src/qa/runtime.ts
+++ b/apps/mobile/src/qa/runtime.ts
@@ -169,6 +169,50 @@ export function createSurface(getHandle: () => unknown, runId: string): Surface
     cleanup,
     sleep,
     now: () => Date.now(),
+    async embedProbe(texts, mode, holdMs) {
+      const { resolveEmbedder } = await import("../documents/embedder");
+      const { initLlama } = await import("llama.rn");
+      const r = resolveEmbedder();
+      if (!r) throw new Error("embedProbe: no index model installed");
+      const round = (v: ArrayLike<number>) => Array.from(v, (x) => Math.round(x * 1e6) / 1e6);
+      const vectors: number[][] = [];
+      const perText: number[] = [];
+      const t0 = Date.now();
+      if (mode === "adapter") {
+        await r.embedder.embed(["warm"]);
+        const loadMs = Date.now() - t0;
+        const began = Date.now();
+        for (const t of texts) {
+          const s = Date.now();
+          vectors.push(round((await r.embedder.embed([t]))[0]!));
+          perText.push(Date.now() - s);
+        }
+        const ms = Date.now() - began;
+        await sleep(holdMs);
+        await r.embedder.unload();
+        return { vectors, model: r.path.split("/").pop() ?? r.path, ms, perText, loadMs };
+      }
+      const n = r.contextTokens;
+      const ctx = await initLlama({ model: r.path, embedding: true, n_ctx: n, n_batch: n, n_ubatch: n, ...(mode === "slot" ? { n_parallel: 1 } : {}), pooling_type: "mean", embd_normalize: 2, n_gpu_layers: 99, use_mlock: false });
+      if (mode === "slot") await ctx.parallel.enable({ n_parallel: 1, n_batch: n });
+      const loadMs = Date.now() - t0;
+      const began = Date.now();
+      for (const t of texts) {
+        const s = Date.now();
+        if (mode === "slot") {
+          const { promise } = await ctx.parallel.embedding(t);
+          vectors.push(round((await promise).embedding));
+        } else {
+          vectors.push(round((await ctx.embedding(t)).embedding));
+          if (mode === "dummy") await ctx.embedding("~");
+        }
+        perText.push(Date.now() - s);
+      }
+      const ms = Date.now() - began;
+      await sleep(holdMs);
+      await ctx.release();
+      return { vectors, model: r.path.split("/").pop() ?? r.path, ms, perText, loadMs };
+    },
   };
 }
 
