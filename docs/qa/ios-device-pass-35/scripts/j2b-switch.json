   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "text-based",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "unable to see",
   "testID": "assistant-text",
   "absent": true
  },
  {
   "op": "assertText",
   "text": "not able to see",
   "testID": "assistant-text",
   "absent": true
  },
  {
