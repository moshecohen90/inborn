   "timeoutMs": 240000
  },
  {
   "op": "waitFor",
   "testID": "stop",
   "gone": true,
   "timeoutMs": 400000
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "value",
   "testID": "assistant-text"
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "waitFor",
   "testID": "vision-hold",
