{
  "runId": "h3-sheet-turbine",
  "_": "Documents → the turbine report → Ask: build 39's leaked question (J9-20). The shell replaces DOCID_T with the id from h2's dump.",
  "steps": [
    {
      "op": "deeplink",
      "url": "/documents"
    },
    {
      "op": "waitFor",
      "testID": "doc-select-DOCID_T",
      "timeoutMs": 30000
    },
    {
      "op": "sleep",
      "ms": 5000
    },
    {
      "op": "press",
      "testID": "doc-select-DOCID_T"
    },
    {
      "op": "press",
      "testID": "documents-ask-selected"
    },
    {
      "op": "waitFor",
      "testID": "ask-sheet",
      "timeoutMs": 20000
    },
    {
      "op": "type",
      "testID": "ask-input",
      "text": "Who wrote this report?"
    },
    {
      "op": "press",
      "testID": "ask-send"
    },
    {
      "op": "waitFor",
      "testID": "ask-stop",
      "timeoutMs": 30000
    },
    {
      "op": "waitFor",
      "testID": "ask-stop",
      "gone": true,
      "timeoutMs": 600000
    },
    {
      "op": "sleep",
      "ms": 2000
    },
    {
      "op": "screenshot",
      "name": "03-turbine-who-wrote"
    },
    {
      "op": "dump",
      "name": "03-turbine-who-wrote"
    }
  ]
}