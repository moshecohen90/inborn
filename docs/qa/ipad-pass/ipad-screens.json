{
  "runId": "ipad-screens",
  "_": "F323: the main screens on an iPad simulator through the in-app bridge. Run: node scripts/ios-qa.mjs docs/qa/ipad-pass/ipad-screens.json --out docs/qa/ipad-pass/sim --simulator --device <sim-udid> --bundle com.inbornapp.mobile.qa --launch --timeout 900000",
  "steps": [
    { "op": "sleep", "ms": 3000 },
    { "op": "screenshot", "name": "I00-chat-root" },
    { "op": "dump", "name": "chat-root" },
    { "op": "value", "testID": "composer-input" },
    { "op": "press", "testID": "model-chip" },
    { "op": "waitFor", "testID": "model-sheet", "timeoutMs": 10000 },
    { "op": "sleep", "ms": 1200 },
    { "op": "screenshot", "name": "I01-model-sheet" },
    { "op": "dump", "name": "model-sheet" },
    { "op": "press", "testID": "model-sheet-close" },
    { "op": "waitFor", "testID": "model-sheet", "gone": true, "timeoutMs": 10000 },
    { "op": "deeplink", "url": "/settings" },
    { "op": "waitFor", "testID": "row-proof", "timeoutMs": 15000 },
    { "op": "sleep", "ms": 1200 },
    { "op": "screenshot", "name": "I02-settings" },
    { "op": "dump", "name": "settings" },
    { "op": "deeplink", "url": "/paywall" },
    { "op": "sleep", "ms": 2000 },
    { "op": "screenshot", "name": "I03-paywall" },
    { "op": "dump", "name": "paywall" },
    { "op": "deeplink", "url": "/proof" },
    { "op": "sleep", "ms": 2000 },
    { "op": "screenshot", "name": "I04-proof" },
    { "op": "dump", "name": "proof" },
    { "op": "deeplink", "url": "/vault" },
    { "op": "sleep", "ms": 2000 },
    { "op": "screenshot", "name": "I05-vault" },
    { "op": "dump", "name": "vault" },
    { "op": "deeplink", "url": "/documents" },
    { "op": "sleep", "ms": 2000 },
    { "op": "screenshot", "name": "I06-documents" },
    { "op": "dump", "name": "documents" },
    { "op": "deeplink", "url": "/" },
    { "op": "waitFor", "testID": "composer-input", "timeoutMs": 15000 },
    { "op": "type", "testID": "composer-input", "text": "iPad hardware Enter check" },
    { "op": "sleep", "ms": 800 },
    { "op": "screenshot", "name": "I07-draft-before-enter" },
    { "op": "value", "testID": "composer-input" },
    { "op": "cleanup" }
  ]
}
