{
  "runId": "s3a-photo-fast",
  "_": "Fresh launch on Fast (the vault default): a new chat, the cafe photo, 'What do you see?'. The shell then raises warning 1.",
  "steps": [
    {
      "op": "waitFor",
      "testID": "composer-input",
      "timeoutMs": 90000
    },
    {
      "op": "deeplink",
      "url": "/chats"
    },
    {
      "op": "waitFor",
      "testID": "new-chat",
      "timeoutMs": 20000
    },
    {
      "op": "press",
      "testID": "new-chat"
    },
    {
      "op": "waitFor",
      "testID": "start-chat",
      "timeoutMs": 10000
    },
    {
      "op": "press",
      "testID": "start-chat"
    },
    {
      "op": "waitFor",
      "testID": "composer-input",
      "timeoutMs": 60000
    },
    {
      "op": "waitFor",
      "text": "Loading",
      "gone": true,
      "timeoutMs": 180000
    },
    {
      "op": "sleep",
      "ms": 1500
    },
    {
      "op": "value",
      "testID": "model-chip"
    },
    {
      "op": "devPrompt",
      "lines": [
        "image: cafe.jpg"
      ]
    },
    {
      "op": "waitFor",
      "testID": "pending-images",
      "timeoutMs": 30000
    },
    {
      "op": "sleep",
      "ms": 2000
    },
    {
      "op": "type",
      "testID": "composer-input",
      "text": "What do you see?"
    },
    {
      "op": "send"
    },
    {
      "op": "sleep",
      "ms": 2500
    },
    {
      "op": "waitFor",
      "testID": "stop",
      "gone": true,
      "timeoutMs": 600000
    },
    {
      "op": "sleep",
      "ms": 2000
    },
    {
      "op": "value",
      "testID": "model-chip"
    },
    {
      "op": "screenshot",
      "name": "04-photo-on-fast"
    }
  ]
}