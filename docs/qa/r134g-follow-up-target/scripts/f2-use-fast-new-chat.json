{
  "runId": "f2-use-fast-new-chat",
  "_": "The shell writes `use fast`; then a new chat on Fast.",
  "steps": [
    {
      "op": "deeplink",
      "url": "/vault"
    },
    {
      "op": "sleep",
      "ms": 10000
    },
    {
      "op": "deeplink",
      "url": "/"
    },
    {
      "op": "waitFor",
      "testID": "open-chats",
      "timeoutMs": 30000
    },
    {
      "op": "press",
      "testID": "open-chats"
    },
    {
      "op": "waitFor",
      "testID": "new-chat",
      "timeoutMs": 15000
    },
    {
      "op": "press",
      "testID": "new-chat"
    },
    {
      "op": "waitFor",
      "testID": "start-chat",
      "timeoutMs": 15000
    },
    {
      "op": "press",
      "testID": "start-chat"
    },
    {
      "op": "waitFor",
      "testID": "composer-input",
      "timeoutMs": 60000
    },
    {
      "op": "sleep",
      "ms": 5000
    },
    {
      "op": "screenshot",
      "name": "f2-chat-fast"
    }
  ]
}